{
  "_Setup": "复制为 appsettings.json；替换全部 <...>；敏感项勿提交 Git",
  "_Setup2": "环境覆盖：appsettings.Development.Example.json / appsettings.Production.Example.json",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "TaktLogging": {
    "AppName": "<应用显示名>",
    "AppVersion": "<版本号>",
    "Environment": "Development",
    "MinLevel": "Info",
    "EnableRemoteReport": false,
    "RemoteReportUrl": "",
    "BatchSize": 20,
    "FlushIntervalMs": 10000,
    "ConsoleOutputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj}{NewLine}{Exception}",
    "FileOutputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "applyThemeToRedirectedOutput": true,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/takt-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}",
          "shared": true
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Localization": {
    "DefaultCulture": "en-US",
    "MultiCultureCode": "mul",
    "_Comment_MultiCultureCode": "多种语言内容通用码（ISO 639-3 mul）；字典等业务表 CultureCode 默认值；≠ Database:CultureCodes 公司区域映射",
    "ResourcesPath": "Resources",
    "UseDatabaseLocalization": true
  },
  "ConnectionStrings": {
    "_Comment": "OpenIddict 认证库；各租户业务库键名 Tenant_{租户编码} 在 Development/Production 覆盖文件中按 TenantCodes 逐项添加",
    "OpenIddict": "Server=<SqlServerHost>;Database=<OpenIddictDatabase>;User Id=<SqlUser>;Password=<SqlPassword>;TrustServerCertificate=true;",
    "ConnectionStringTemplate": "Server=<SqlServerHost>;Database=<TenantDatabase>;User Id=<SqlUser>;Password=<SqlPassword>;TrustServerCertificate=true;"
  },
  "Database": {
    "DbType": 1,
    "_Comment_TenantCodes": "租户编码列表（三位），与 ConnectionStrings 中 Tenant_* 键一致。约定：000=开发环境、100=正式环境、500=demo测试环境",
    "TenantCodes": [ "<TenantCode>" ],
    "_Comment_CompanyCodes": "公司编码列表；须与 PlantCodes、CultureCodes 等长且同序一一对应（CompanyCodes[i]↔PlantCodes[i]↔CultureCodes[i]）；唯一合法公司↔工厂↔区域文化映射源，禁止手写对照表",
    "CompanyCodes": [ "<CompanyCode>" ],
    "_Comment_PlantCodes": "工厂编码列表；须与 CompanyCodes、CultureCodes 等长且同序一一对应；种子 RelatedPlant/RelatedCompany 仅由此解析。统一组成：1 位国家英文名首字母大写 + 公司编码前 3 位（共 4 位）。例：Japan+1000→J100、China+2300→C100、HongKong+2400→H100、China+2700→C270、America+3000→A300",
    "PlantCodes": [ "<PlantCode>" ],
    "_Comment_CultureCodes": "区域文化编码列表（BCP47，如 ja-JP、zh-CN、zh-HK）；须与 CompanyCodes、PlantCodes 等长且同序一一对应；种子/仓储 CultureCode 仅由此解析",
    "CultureCodes": [ "<CultureCode>" ],
    "ConnectionStringTemplate": "Server=<SqlServerHost>;Database=<TenantDatabase>;User Id=<SqlUser>;Password=<SqlPassword>;TrustServerCertificate=true;"
  },
  "Init": {
    "InitDb": false,
    "SeedData": false
  },
  "DatabaseBackup": {
    "_Comment_FtpTempRoot": "默认 wwwroot/Backup（相对 WebApi ContentRoot）。本机 SQL 可直接用；远程 SQL 须改为 UNC（SQL 与 API 均可写）。",
    "FtpTempRoot": "wwwroot/Backup",
    "CredentialProtectionKey": "<替换为生产密钥>"
  },
  "Excel": {
    "Author": "<导出作者>",
    "Title": "<导出标题>",
    "Subject": "<导出主题>",
    "Category": "Export",
    "Keywords": "",
    "Comments": "",
    "Status": "Final",
    "Application": "<应用名>",
    "Company": "<公司名>",
    "Manager": "<负责人>",
    "Import": {
      "MaxRowsPerFile": 100000,
      "MaxSheetsPerFile": 10,
      "MaxRowsPerSheet": 100000
    },
    "Export": {
      "MaxRowsPerRequest": 1000000,
      "MaxRowsPerSheet": 100000,
      "MaxSheetsPerFile": 10
    }
  },
  "Paged": {
    "DefaultPageIndex": 1,
    "DefaultPageSize": 20,
    "MaxPageSize": 1000,
    "PageSizeOptions": [20, 50, 100, 500, 1000]
  },
  "Authentication": {
    "AccessTokenLifetimeHours": 2,
    "RefreshTokenLifetimeDays": 7,
    "RefreshTokenReuseLeewayMinutes": 5
  },
  "TenantContext": {
    "TenantHeaderName": "X-Tenant-Code",
    "CompanyHeaderName": "X-Company-Code"
  },
  "FileUpload": {
    "UploadRelativePath": "uploads",
    "ChunkRelativePath": "uploads/_chunks",
    "MaxFileSizeBytes": 524288000,
    "MaxChunkCount": 10000,
    "DefaultChunkSizeBytes": 2097152,
    "ChunkThresholdBytes": 5242880,
    "AllowedExtensions": [],
    "DeniedExtensions": ["doc", "xls", "ppt"]
  },
  "Security": {
    "RateLimit": {
      "Enabled": true,
      "MaxRequests": 1000,
      "TimeWindowSeconds": 60
    },
    "LoginRateLimit": {
      "Enabled": true,
      "MaxRequests": 10,
      "TimeWindowSeconds": 60
    },
    "CsrfProtection": { "Enabled": true },
    "XssProtection": {
      "Enabled": true,
      "AllowedFileExtensions": [ "pdf", "docx", "xlsx", "png", "jpg", "zip" ]
    }
  },
  "Observability": {
    "HealthChecksEnabled": true,
    "PrometheusEnabled": true,
    "MetricsPath": "/metrics",
    "TracingEnabled": true,
    "OtlpEndpoint": "",
    "ConsoleExporterEnabled": false,
    "ServiceName": "Takt.WebApi"
  },
  "PasswordPolicy": {
    "DefaultPassword": "<种子默认密码>",
    "MinLength": 8,
    "RequireDigit": true,
    "RequireLowercase": true,
    "RequireUppercase": true,
    "RequireSpecialCharacter": true,
    "Transport": {
      "Enabled": true,
      "_Comment": "生成 RSA 密钥对后填入，勿提交私钥到 Git",
      "PublicKeyPem": "",
      "PrivateKeyPem": ""
    }
  },
  "AccountLock": {
    "Enabled": true,
    "ErrorLimit": 5,
    "LockDurationMinutes": 30,
    "LockReason": "连续登录失败{ErrorCount}次，达到错误次数限制（{ErrorLimit}次）"
  },
  "System": {
    "SingleLogin": false,
    "ShowDbLog": false,
    "DemoMode": false,
    "Environment": "Development"
  },
  "PrimaryKeyType": {
    "Identity": { "Enabled": true },
    "Guid": { "Enabled": true },
    "Snowflake": {
      "Enabled": true,
      "WorkId": 0,
      "_Comment": "WorkId 0-63 每台服务器唯一，见 appsettings.Snowflake.example.json"
    }
  },
  "Captcha": {
    "Enabled": true,
    "Type": "Behavior",
    "ExpirationMinutes": 5
  },
  "Cache": {
    "Provider": "Memory",
    "DefaultExpirationMinutes": 30,
    "EnableSlidingExpiration": true,
    "Menu": { "Enabled": true },
    "Memory": {
      "SizeLimit": 4096,
      "CompactionPercentage": 0.25,
      "ExpirationScanFrequency": 60
    },
    "Redis": {
      "Enabled": false,
      "ConnectionString": "",
      "InstanceName": "<Redis实例前缀>",
      "DefaultDatabase": 0,
      "Password": ""
    }
  },
  "Email": {
    "SmtpHost": "<SmtpHost>",
    "SmtpPort": 587,
    "SmtpUserName": "<SmtpUser>",
    "SmtpPassword": "<SmtpPassword>",
    "FromEmail": "<FromEmail>",
    "FromName": "<FromName>",
    "EnableSsl": true,
    "SkipSslCertificateValidation": false,
    "EnableAttachments": true,
    "MaxAttachmentSizeMB": 25,
    "MaxEmailSizeMB": 50
  },
  "Oss": {
    "aliyun": {
      "Endpoint": "<OssEndpoint>",
      "AccessKeyId": "<AccessKeyId>",
      "AccessKeySecret": "<AccessKeySecret>",
      "Bucket": "<Bucket>",
      "Region": "<Region>"
    }
  },
  "Ftp": {
    "teac_cn": {
      "Host": "<FtpHost>",
      "Port": 21,
      "user_name": "<FtpUser>",
      "Password": "<FtpPassword>",
      "EnableSsl": false,
      "Timeout": 30,
      "BasePath": "/"
    }
  },
  "AllowedHosts": "*"
}

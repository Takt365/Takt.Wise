{
  "_Setup": "复制为 appsettings.Production.json；替换全部 <...>",
  "_Comment_ConnectionStrings": "按 Database:TenantCodes 为每个租户增加 Tenant_{编码} 项，键名勿保留字面量 Tenant_<TenantCode>",
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "OpenIddict": "Server=<SqlServerHost>;Database=<OpenIddictPrdDatabase>;User Id=<SqlUser>;Password=<SqlPassword>;TrustServerCertificate=true;",
    "Tenant_<TenantCode>": "Server=<SqlServerHost>;Database=<TenantPrdDatabase>;User Id=<SqlUser>;Password=<SqlPassword>;TrustServerCertificate=true;"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://<生产前端域名>"
    ],
    "AllowedMethods": [ "GET", "POST", "PUT", "DELETE", "OPTIONS" ],
    "AllowedHeaders": [ "Authorization", "Content-Type", "Accept-Language", "X-Tenant-Code", "X-Company-Code", "X-Takt-Readonly-Fields" ],
    "AllowCredentials": true
  },
  "OpenIddict": {
    "Issuer": "https://<生产前端域名>/",
    "SpaClientId": "<SpaClientId>",
    "SpaRedirectUris": [
      "https://<生产前端域名>/auth/callback"
    ],
    "SpaPostLogoutRedirectUris": [
      "https://<生产前端域名>/login"
    ],
    "FrontendLoginUrl": "https://<生产前端域名>/login",
    "ApiAudience": "<ApiAudience>",
    "AccessTokenLifetime": "02:00:00",
    "RefreshTokenLifetime": "14.00:00:00"
  }
}

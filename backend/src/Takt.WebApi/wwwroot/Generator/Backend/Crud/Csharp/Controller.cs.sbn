{{~ else if type == "ImportDto" ~}}
    /// <summary>
    /// 导入{{ table.comment }}
    /// </summary>
    [TaktPermission("{{ table.perms_prefix_canonical }}:import", "导入{{ table.comment }}")]
    [HttpPost("import")]
    public async Task<IActionResult> Import{{ table.entity_name_pascal }}Async(IFormFile file, [FromQuery] string? sheetName = null)
    {
        try
        {
            if (file == null || file.Length == 0)
            {
                return BadRequest("请选择要导入的文件");
            }
            await using var stream = file.OpenReadStream();
            var (success, fail, errors) = await _{{ table.entity_name_camel }}Service.Import{{ table.entity_name_pascal }}Async(stream, sheetName);
            return Success(new
            {
                SuccessCount = success,
                FailCount = fail,
                Errors = errors
            }, $"导入完成：成功{success}条，失败{fail}条");
        }
        catch (Exception ex)
        {
            return HandleException(ex);
        }
    }
{{~ else if type == "ExportDto" ~}}

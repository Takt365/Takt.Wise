# ========================================
# 前端环境变量模板（无真实地址/端口，复制后自行填写）
#   copy env.example .env
#   copy env.development.example .env.development
#   copy env.production.example .env.production
# 含空格 / # 的值须双引号；占位符 <...> 必须替换
# ========================================

VITE_APP_TITLE="TaktWise"

# 根地址仅写在 .env.development / .env.production（此处勿写，避免空值覆盖模式文件）
# VITE_APP_ORIGIN=https://<前端主机>:<前端端口>

# 开发用相对路径 + 代理；生产在 .env.production 改为完整 URL
VITE_API_BASE_URL=/api

# 与 VITE_APP_ORIGIN 端口一致
VITE_DEV_SERVER_PORT=<前端端口>

VITE_BUILD_TARGET=es2022
VITE_BUILD_SOURCEMAP=false

# 仅开发：后端 HTTPS 根地址（与 README / 本地 launchSettings 一致后填写）
# VITE_API_PROXY_TARGET=https://<后端主机>:<后端HTTPS端口>
VITE_API_PROXY_CHANGE_ORIGIN=true
VITE_API_PROXY_SECURE=false
VITE_PROXY_PATH_CONNECT=/connect
VITE_PROXY_PATH_HUBS=/hubs

VITE_DEV_SERVER_HTTPS=true
VITE_DEV_SERVER_HOST=

# 须与后端 OpenIddict SpaClientId 一致（公开客户端 ID，非密钥）
VITE_OAUTH_CLIENT_ID=takt-spa
# VITE_OAUTH_REDIRECT_URI=https://<前端主机>:<前端端口>/auth/callback
VITE_AUTH_IDLE_TIMEOUT_MINUTES=30
VITE_AUTH_IDLE_WARNING_MINUTES=5

VITE_OAUTH_SCOPE="openid profile email offline_access"
VITE_OAUTH_AUTHORIZE_PATH=/connect/authorize
VITE_OAUTH_TOKEN_PATH=/connect/token

VITE_SIGNALR_HUB_CONNECT_PATH=/hubs/TaktConnectHub
VITE_SIGNALR_HUB_NOTIFICATION_PATH=/hubs/TaktNotificationHub
VITE_SIGNALR_HUB_EC_CHANGE_PATH=/hubs/TaktEcChangeHub

# 统一日志（开发默认落盘 frontend/logs；生产可改 VITE_LOG_ENABLE_REPORT）
VITE_LOG_MIN_LEVEL=info
VITE_LOG_ENABLE_CONSOLE=false
VITE_LOG_ENABLE_FILE=false
VITE_LOG_FILE_URL=/__takt/client-logs
VITE_LOG_ENABLE_REPORT=false
VITE_LOG_BATCH_SIZE=20
VITE_LOG_FLUSH_INTERVAL_MS=10000

# 客户端三位一体性能监控（Long Task + FPS + CRUD API → TaktEventTrackingLogs/track-batch）
VITE_EVENT_TRACKING_ENABLED=true
VITE_EVENT_TRACKING_REPORT_ENABLED=true
VITE_EVENT_TRACKING_BATCH_SIZE=20
VITE_EVENT_TRACKING_FLUSH_MS=10000
# 阈值依据：W3C Long Tasks API / RAIL / Google Core Web Vitals
VITE_LONG_TASK_MONITOR_ENABLED=true
# 采集下限固定 50ms（W3C）；Warning 默认 300ms；Error 默认 500ms（INP Poor）
VITE_LONG_TASK_WARN_MS=300
VITE_LONG_TASK_ERROR_MS=500
VITE_FPS_MONITOR_ENABLED=true
# 页面停留 FPS：visibility hidden / 路由切换结束会话，上报 p50/p75（体验补充，非告警）
VITE_FPS_DWELL_MIN_MS=1000
# 即时掉帧告警（默认关；与停留 FPS 无关）
VITE_FPS_DROP_ALERT_ENABLED=false
VITE_FPS_WARN_THRESHOLD=30
VITE_FPS_SAMPLE_MS=1000
VITE_FPS_REPORT_COOLDOWN_MS=5000
VITE_API_PERF_TRACK_ENABLED=true
# API 慢请求：交互式应用 warn 1s / error 3s（非 CWV 指标）
VITE_API_SLOW_MS=1000
VITE_API_ERROR_MS=3000
VITE_WEB_VITALS_MONITOR_ENABLED=true
VITE_FCP_WARN_MS=1800
# LCP Warning 2.5s / Poor 4s；INP Warning 200ms / Poor 500ms；CLS Warning 0.1 / Poor 0.25
VITE_LCP_WARN_MS=2500
VITE_LCP_ERROR_MS=4000
VITE_INP_WARN_MS=200
VITE_INP_ERROR_MS=500
VITE_CLS_WARN=0.1
VITE_CLS_ERROR=0.25
VITE_CORRELATION_WINDOW_MS=3000

VITE_PWA_ENABLED=true
VITE_PWA_DEV_ENABLED=false
VITE_PWA_SHORT_NAME="Takt"
VITE_PWA_THEME_COLOR="#1677ff"
VITE_PWA_BACKGROUND_COLOR="#ffffff"
VITE_PWA_DESCRIPTION="节拍智控·TaktWise"

# ========================================
# 开发环境模板（复制为 .env.development，替换全部 <...>）
# 须与本地 backend appsettings.Development.json 中 Cors / OpenIddict 地址一致
# ========================================

VITE_APP_TITLE="TaktWise - Development"

VITE_APP_ORIGIN=https://<前端主机>:<前端端口>

VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=https://<后端主机>:<后端HTTPS端口>

VITE_OAUTH_REDIRECT_URI=https://<前端主机>:<前端端口>/auth/callback

# 开发：本地 logs 落盘（须 npm run dev；Vite 插件写入 frontend/logs）
VITE_LOG_MIN_LEVEL=debug
VITE_LOG_ENABLE_CONSOLE=true
VITE_LOG_ENABLE_FILE=true
VITE_LOG_FILE_URL=/__takt/client-logs
VITE_LOG_ENABLE_REPORT=false

VITE_EVENT_TRACKING_ENABLED=true
VITE_EVENT_TRACKING_REPORT_ENABLED=true
VITE_LONG_TASK_MONITOR_ENABLED=true
VITE_LONG_TASK_WARN_MS=300
VITE_LONG_TASK_ERROR_MS=500
VITE_FPS_MONITOR_ENABLED=true
VITE_FPS_WARN_THRESHOLD=30
VITE_API_PERF_TRACK_ENABLED=true
VITE_API_SLOW_MS=1000

VITE_DEV_SERVER_HTTPS=true
VITE_DEV_SERVER_HOST=

VITE_PWA_ENABLED=true
VITE_PWA_DEV_ENABLED=false
VITE_PWA_SHORT_NAME="Takt"
VITE_PWA_THEME_COLOR="#1677ff"
VITE_PWA_BACKGROUND_COLOR="#ffffff"
VITE_PWA_DESCRIPTION="节拍智控·TaktWise"
